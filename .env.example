# ============================================================
# Lilly's Restaurant & Cafe — Environment Variables
# ============================================================

# --- LOCAL DEV (SQLite) ---
# DATABASE_URL="file:./dev.db"

# --- PRODUCTION (Neon / Vercel Postgres / Supabase) ---
# Paste your connection string from your Postgres provider below:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# App
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
