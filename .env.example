# ----------------------------------------------------------------------------
# Artisan Cafe POS & Restaurant Suite Environment Configuration
# ----------------------------------------------------------------------------

# 1. LOCAL SQLITE DATABASE (Default)
DATABASE_URL="file:./dev.db"

# 2. CLOUD DATABASE PROVIDERS (Uncomment your choice & run `npm run db:cloud`)
#
# A. Supabase PostgreSQL (Recommended Managed Cloud DB with Pooling):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# B. Neon Serverless Postgres:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require"
#
# C. AWS RDS / Google Cloud SQL / Railway:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/cafe_pos?sslmode=require"

# ----------------------------------------------------------------------------
# Thermal Receipt Printer Defaults (Configurable via POS in-app UI)
# ----------------------------------------------------------------------------
# DEFAULT_PRINTER_TYPE="network" # network, usb, bluetooth, system
# DEFAULT_PRINTER_IP="192.168.1.100"
# DEFAULT_PRINTER_PORT="9100"
# DEFAULT_PAPER_WIDTH="80mm" # 80mm or 58mm

